{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "runpod-glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM-5.3-Flash (RunPod)",
      "options": {
        "baseURL": "https://YOUR-POD-ID-8000.proxy.runpod.net/v1"
      },
      "models": {
        "glm53-uncensored": {
          "name": "GLM-5.3-Flash UNCENSORED (abliterated)",
          "limit": {
            "context": 1048576,
            "output": 16384
          },
          "tool_call": true
        }
      }
    }
  }
}